---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import { tServer } from '../lib/i18n/server';

interface Props {
  title?: string;
  titleKey?: string;
}

const { title, titleKey } = Astro.props;
const pageTitle = titleKey ? tServer(Astro.locals.locale, titleKey) : title;
const metaDescription = tServer(Astro.locals.locale, 'layout.metaDescriptionSetup');
const setupTagline = tServer(Astro.locals.locale, 'titles.setup');
---

<!DOCTYPE html>
<html lang={Astro.locals.locale ?? 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle} | Breeze RMM</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background antialiased">
    <div class="flex min-h-screen items-center justify-center px-4 py-12">
      <div class="w-full max-w-3xl space-y-8">
        <div class="text-center">
          <div class="mx-auto flex h-[132px] w-[132px] items-center justify-center rounded-lg bg-primary/15">
            <img src="/branding.png" alt="" width="90" height="90" class="object-contain" />
          </div>
          <p class="mt-3 text-sm text-muted-foreground">Initial Setup</p>
        </div>

        <slot />
      </div>
    </div>
  </body>
</html>
